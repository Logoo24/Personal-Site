{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/family.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/finance-cron", "schedule": "0 11 * * *" }
  ],
  "rewrites": [
    { "source": "/api/finance-cron", "destination": "/api/family?r=fin-cron" },
    { "source": "/recipes/:slug/photos/:file", "destination": "/api/recipe?slug=:slug&f=:file" },
    { "source": "/recipes/:slug", "destination": "/api/recipe?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/family/manage", "permanent": false },
    { "source": "/admin/:path*", "destination": "/family/manage", "permanent": false }
  ]
}
